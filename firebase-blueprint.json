        "department": { "type": "string", "enum": ["fee_recovery", "practical", "tma", "online_classes", "admission"] },
        "requesterUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterName": { "type": "string", "maxLength": 100 },
        "requesterEmail": { "type": "string", "maxLength": 160 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "reviewedByName": { "type": "string", "maxLength": 100 },
        "reviewerNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "studentId", "studentName", "serialNumber", "centreId", "department", "requesterUid", "requesterName", "requesterEmail", "reason", "status", "reviewedByUid", "reviewedByName", "reviewerNote", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Hub-and-spoke direct communication message strictly between Super Admin and an individual staff member (no peer-to-peer staff messaging)",
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "staffName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "staffEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "staffRole": { "type": "string", "enum": ["centre_head", "employee"] },
        "centreId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "department": { "type": "string", "enum": ["all", "fee_recovery", "practical", "tma", "online_classes", "admission"] },
        "senderUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderRole": { "type": "string", "enum": ["super_admin", "centre_head", "employee"] },
        "messageType": { "type": "string", "enum": ["text", "walkie_log"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "readByStaff": { "type": "boolean" },
        "readByAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "staffUid", "staffName", "staffEmail", "staffRole", "centreId", "department", "senderUid", "senderName", "senderRole", "messageType", "text", "readByStaff", "readByAdmin", "createdAt"]
    },
    "ExcelSheetConfig": {
      "title": "ExcelSheetConfig",
      "description": "Shared Excel column schema, custom column definitions, hidden core columns, and editable column headings",
      "type": "object",
      "properties": {
        "configId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "headerLabels": { "type": "object", "description": "Custom display headings mapped by core column key" },
        "customColumns": { "type": "array", "description": "Ordered custom extra column headings" },
        "hiddenCoreColumns": { "type": "array", "description": "Core column keys hidden from sheet view" },
        "deletedExtraColumns": { "type": "array", "description": "Deleted custom column keys excluded from merge" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["configId", "headerLabels", "customColumns", "hiddenCoreColumns", "deletedExtraColumns", "updatedBy", "updatedAt"]
    }
  },
