      );
      allow update: if isValidId(inviteId) && isVerifiedUser() && isValidStaffInvite(incoming()) && incoming().inviteId == existing().inviteId && incoming().email == existing().email && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isSuperAdmin() ||
        (isActiveUser() && userDoc().role == 'centre_head' && existing().role == 'employee' && incoming().role == 'employee' && existing().centreId == userDoc().centreId && incoming().centreId == userDoc().centreId && incoming().department != 'all') ||
        (request.auth.token.email_verified == true && existing().status == 'Pending' && existing().email == request.auth.token.email.lower() && incoming().role == existing().role && incoming().centreId == existing().centreId && incoming().department == existing().department && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedUid', 'updatedAt']) && incoming().status == 'Claimed' && incoming().claimedUid == request.auth.uid)
      );
      allow delete: if isValidId(inviteId) && (
        isSuperAdmin() ||
        (isActiveUser() && userDoc().role == 'centre_head' && existing().role == 'employee' && existing().centreId == userDoc().centreId)
      );
    }

    match /employee_reports/{reportId} {
      allow get: if isValidId(reportId) && (
        isSuperAdmin() ||
        isCentreHeadOf(resource.data.centreId) ||
        (isActiveUser() && resource.data.employeeUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (
        isActiveUser() && (
          (userDoc().role == 'centre_head' && resource.data.centreId == userDoc().centreId) ||
          resource.data.employeeUid == request.auth.uid
        )
      );
      allow create: if isValidId(reportId) && isActiveUser() && isValidEmployeeReport(incoming()) && incoming().reportId == reportId && incoming().employeeUid == request.auth.uid && incoming().status == 'Submitted' && incoming().createdAt == request.time && incoming().updatedAt == request.time && (
        isSuperAdmin() ||
        (incoming().centreId == userDoc().centreId && (userDoc().role == 'centre_head' || incoming().department == userDoc().department))
      );
      allow update: if isValidId(reportId) && isActiveUser() && isValidEmployeeReport(incoming()) && incoming().reportId == existing().reportId && incoming().employeeUid == existing().employeeUid && incoming().centreId == existing().centreId && incoming().department == existing().department && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        ((isSuperAdmin() || isCentreHeadOf(existing().centreId)) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerName', 'reviewerNote', 'updatedAt'])) ||
        (existing().employeeUid == request.auth.uid && existing().status == 'Submitted' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'tasksCompleted', 'studentsHandled', 'pendingIssues', 'updatedAt']))
      );
      allow delete: if isValidId(reportId) && isSuperAdmin();
    }

    match /edit_requests/{requestId} {
      allow get: if isValidId(requestId) && (
        isSuperAdmin() ||
        isCentreHeadOf(resource.data.centreId) ||
        (isActiveUser() && resource.data.requesterUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (
        isActiveUser() && (
          (userDoc().role == 'centre_head' && resource.data.centreId == userDoc().centreId) ||
          resource.data.requesterUid == request.auth.uid
        )
      );
      allow create: if isValidId(requestId) && isActiveUser() && isValidEditRequest(incoming())
        && incoming().requestId == requestId
        && incoming().requesterUid == request.auth.uid
        && incoming().centreId == userDoc().centreId
        && userDoc().role == 'employee'
        && incoming().department == userDoc().department
        && incoming().status == 'Pending'
        && incoming().reviewedByUid == ''
        && incoming().reviewedByName == ''
        && incoming().reviewerNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isValidId(requestId) && isActiveUser() && isValidEditRequest(incoming())
        && (isSuperAdmin() || isCentreHeadOf(existing().centreId))
        && existing().status == 'Pending'
        && incoming().status in ['Approved', 'Rejected']
        && incoming().requestId == existing().requestId
        && incoming().studentId == existing().studentId
        && incoming().centreId == existing().centreId
        && incoming().department == existing().department
        && incoming().requesterUid == existing().requesterUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewedByName', 'reviewerNote', 'updatedAt']);
      allow delete: if isValidId(requestId) && isSuperAdmin();
    }

    match /direct_messages/{messageId} {
      allow get: if isValidId(messageId) && (
        isSuperAdmin() ||
        (isActiveUser() && resource.data.staffUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (
        isActiveUser() && resource.data.staffUid == request.auth.uid
      );
      allow create: if isValidId(messageId) && isActiveUser() && isValidDirectMessage(incoming())
        && incoming().messageId == messageId
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(incoming().staffUid))
        && (
          (isSuperAdmin() && incoming().senderRole == 'super_admin' && incoming().readByAdmin == true) ||
          (
            !isSuperAdmin()
            && incoming().staffUid == request.auth.uid
            && incoming().senderRole == userDoc().role
            && incoming().staffRole == userDoc().role
            && incoming().centreId == userDoc().centreId
            && incoming().readByStaff == true
            && incoming().readByAdmin == false
          )
        );
      allow update: if isValidId(messageId) && isActiveUser() && isValidDirectMessage(incoming())
        && incoming().messageId == existing().messageId
        && incoming().staffUid == existing().staffUid
        && incoming().staffName == existing().staffName
        && incoming().staffEmail == existing().staffEmail
        && incoming().staffRole == existing().staffRole
        && incoming().centreId == existing().centreId
        && incoming().department == existing().department
        && incoming().senderUid == existing().senderUid
        && incoming().senderName == existing().senderName
        && incoming().senderRole == existing().senderRole
        && incoming().messageType == existing().messageType
        && incoming().text == existing().text
        && incoming().createdAt == existing().createdAt
        && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['readByAdmin'])) ||
          (!isSuperAdmin() && existing().staffUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['readByStaff']) && incoming().readByStaff == true)
        );
      allow delete: if isValidId(messageId) && isSuperAdmin();
    }

    match /excel_sheet_configs/{configId} {
      allow get: if isValidId(configId) && isActiveUser();
      allow list: if isActiveUser();
      allow create: if isValidId(configId) && isActiveUser() && isValidExcelSheetConfig(incoming())
        && incoming().configId == configId
        && incoming().updatedAt == request.time
        && (isSuperAdmin() || isCentreHeadOf(configId));
      allow update: if isValidId(configId) && isActiveUser() && isValidExcelSheetConfig(incoming())
        && incoming().configId == existing().configId
        && incoming().updatedAt == request.time
        && (isSuperAdmin() || isCentreHeadOf(configId));
      allow delete: if isValidId(configId) && isSuperAdmin();
    }
  }
}
