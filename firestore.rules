rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn();
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() in [
        'niosvisionpoint9@gmail.com',
        'krishnasharma011981@gmail.com'
      ];
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isVerifiedUser() && hasUserDoc() && userDoc().status == 'Active';
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (isActiveUser() && userDoc().role == 'super_admin');
    }

    function isCentreHeadOf(centreId) {
      return isActiveUser() && userDoc().role == 'centre_head' && userDoc().centreId == centreId;
    }

    function isEmployeeOf(centreId, dept) {
      return isActiveUser() && userDoc().role == 'employee' && userDoc().centreId == centreId && userDoc().department == dept;
    }

    function isValidStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 3. Entity Validation Blueprints
    function isValidCentre(data) {
      return data.keys().hasAll([
        'id', 'name', 'city', 'code', 'address', 'latitude', 'longitude',
        'geofenceRadiusMeters', 'headUid', 'headName', 'status', 'createdAt', 'updatedAt', 'updatedBy'
      ]) && data.keys().hasOnly([
        'id', 'name', 'city', 'code', 'address', 'latitude', 'longitude',
        'geofenceRadiusMeters', 'headUid', 'headName', 'status', 'createdAt', 'updatedAt', 'updatedBy'
      ])
      && isValidId(data.id)
      && isValidStr(data.name, 3, 120)
      && isValidStr(data.city, 2, 60)
      && isValidStr(data.code, 2, 20)
      && isValidStr(data.address, 0, 250)
      && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
      && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
      && data.geofenceRadiusMeters is number && data.geofenceRadiusMeters >= 20 && data.geofenceRadiusMeters <= 10000
      && isValidStr(data.headUid, 0, 128)
      && isValidStr(data.headName, 0, 100)
      && data.status in ['Active', 'Inactive']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && isValidStr(data.updatedBy, 1, 128);
    }

    function isValidUser(data) {
      return data.keys().hasAll([
        'uid', 'fullName', 'email', 'mobileNumber', 'role', 'centreId', 'centreName',
        'department', 'status', 'joiningDate', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'fullName', 'email', 'mobileNumber', 'role', 'centreId', 'centreName',
        'department', 'status', 'joiningDate', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isValidStr(data.fullName, 2, 100)
      && isValidStr(data.email, 5, 160)
      && isValidStr(data.mobileNumber, 0, 20)
      && data.role in ['super_admin', 'centre_head', 'employee']
      && isValidId(data.centreId)
      && isValidStr(data.centreName, 2, 120)
      && data.department in ['all', 'fee_recovery', 'practical', 'tma', 'online_classes', 'admission']
      && data.status in ['Active', 'Inactive']
      && isValidStr(data.joiningDate, 4, 30)
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
        'serialNumber', 'studentId', 'studentName', 'mobileNumber', 'subject',
        'tcStatus', 'bookStatus', 'classAttendanceStatus', 'whyNios',
        'currentEducationStatus', 'futurePlanning', 'tmaStatus', 'practicalStatus',
        'examinationStatus', 'centreId', 'centreName', 'admissionDate',
        'assignedEmployeeUid', 'assignedEmployeeName', 'additionalRemarks',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'serialNumber', 'studentId', 'studentName', 'mobileNumber', 'subject',
        'tcStatus', 'bookStatus', 'classAttendanceStatus', 'whyNios',
        'currentEducationStatus', 'futurePlanning', 'tmaStatus', 'practicalStatus',
        'examinationStatus', 'centreId', 'centreName', 'admissionDate',
        'assignedEmployeeUid', 'assignedEmployeeName', 'additionalRemarks',
        'employeeLocked', 'tmaLocked', 'practicalLocked', 'onlineClassesLocked', 'admissionLocked',
        'lockedByUid', 'lockedByName', 'superAdminAccessGranted', 'tmaFee', 'examFee', 'extraColumns',
        'rowColor', 'cellColors',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && data.serialNumber is number && data.serialNumber >= 1
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidStr(data.mobileNumber, 7, 20)
      && isValidStr(data.subject, 1, 200)
      && data.tcStatus in ['Received', 'Not Received', 'Not Applicable']
      && data.bookStatus in ['Received', 'Not Received', 'Pending']
      && data.classAttendanceStatus in ['Regular', 'Irregular', 'Not Attending']
      && isValidStr(data.whyNios, 0, 1000)
      && isValidStr(data.currentEducationStatus, 0, 1000)
      && isValidStr(data.futurePlanning, 0, 1000)
      && data.tmaStatus in ['Submitted', 'Not Submitted', 'Pending']
      && data.practicalStatus in ['Completed', 'Not Completed', 'Pending']
      && data.examinationStatus in ['Completed', 'Not Completed', 'Partially Completed']
      && isValidId(data.centreId)
      && isValidStr(data.centreName, 2, 120)
      && isValidStr(data.admissionDate, 4, 30)
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && isValidStr(data.additionalRemarks, 0, 1000)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('tmaLocked' in data) || data.tmaLocked is bool)
      && (!('practicalLocked' in data) || data.practicalLocked is bool)
      && (!('onlineClassesLocked' in data) || data.onlineClassesLocked is bool)
      && (!('admissionLocked' in data) || data.admissionLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && (!('superAdminAccessGranted' in data) || data.superAdminAccessGranted is bool)
      && (!('tmaFee' in data) || (data.tmaFee is number && data.tmaFee >= 0 && data.tmaFee <= 1000000))
      && (!('examFee' in data) || (data.examFee is number && data.examFee >= 0 && data.examFee <= 1000000))
      && (!('extraColumns' in data) || (data.extraColumns is map && data.extraColumns.size() <= 35))
      && (!('rowColor' in data) || (data.rowColor is string && data.rowColor.size() <= 20))
      && (!('cellColors' in data) || (data.cellColors is map && data.cellColors.size() <= 45))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidFeeRecovery(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'mobileNumber', 'centreId', 'recoveryStatus',
        'followUpStatus', 'totalFee', 'paidAmount', 'pendingAmount',
        'assignedEmployeeUid', 'assignedEmployeeName', 'followUpNotes',
        'lastContactDate', 'nextFollowUpDate', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'studentId', 'studentName', 'mobileNumber', 'centreId', 'recoveryStatus',
        'followUpStatus', 'totalFee', 'paidAmount', 'pendingAmount',
        'assignedEmployeeUid', 'assignedEmployeeName', 'followUpNotes',
        'lastContactDate', 'nextFollowUpDate', 'tmaFee', 'examFee', 'employeeLocked', 'lockedByUid', 'lockedByName',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidStr(data.mobileNumber, 7, 20)
      && isValidId(data.centreId)
      && data.recoveryStatus in ['Paid', 'Partial', 'Pending', 'Overdue']
      && data.followUpStatus in ['Scheduled', 'Contacted', 'Promise to Pay', 'Closed']
      && data.totalFee is number && data.totalFee >= 0
      && data.paidAmount is number && data.paidAmount >= 0
      && data.pendingAmount is number && data.pendingAmount >= 0
      && (!('tmaFee' in data) || (data.tmaFee is number && data.tmaFee >= 0 && data.tmaFee <= 1000000))
      && (!('examFee' in data) || (data.examFee is number && data.examFee >= 0 && data.examFee <= 1000000))
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && isValidStr(data.followUpNotes, 0, 1000)
      && isValidStr(data.lastContactDate, 0, 30)
      && isValidStr(data.nextFollowUpDate, 0, 30)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidPracticalRecord(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'centreId', 'practicalStatus', 'submissionStatus',
        'completionPercentage', 'assignedEmployeeUid', 'assignedEmployeeName', 'remarks',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'studentId', 'studentName', 'centreId', 'practicalStatus', 'submissionStatus',
        'completionPercentage', 'assignedEmployeeUid', 'assignedEmployeeName', 'remarks',
        'employeeLocked', 'lockedByUid', 'lockedByName',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidId(data.centreId)
      && data.practicalStatus in ['Completed', 'Not Completed', 'Pending']
      && data.submissionStatus in ['Submitted', 'Not Submitted', 'Under Review']
      && data.completionPercentage is number && data.completionPercentage >= 0 && data.completionPercentage <= 100
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && isValidStr(data.remarks, 0, 1000)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidTmaRecord(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'centreId', 'tmaStatus', 'subjectsSubmittedCount',
        'totalSubjectsCount', 'submissionDate', 'assignedEmployeeUid', 'assignedEmployeeName',
        'remarks', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'studentId', 'studentName', 'centreId', 'tmaStatus', 'subjectsSubmittedCount',
        'totalSubjectsCount', 'submissionDate', 'assignedEmployeeUid', 'assignedEmployeeName',
        'remarks', 'employeeLocked', 'lockedByUid', 'lockedByName',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidId(data.centreId)
      && data.tmaStatus in ['Submitted', 'Not Submitted', 'Pending']
      && data.subjectsSubmittedCount is number && data.subjectsSubmittedCount >= 0 && data.subjectsSubmittedCount <= 20
      && data.totalSubjectsCount is number && data.totalSubjectsCount >= 1 && data.totalSubjectsCount <= 20
      && isValidStr(data.submissionDate, 0, 30)
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && isValidStr(data.remarks, 0, 1000)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidOnlineClassRecord(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'centreId', 'attendanceStatus', 'participationLevel',
        'attendancePercentage', 'lastAttendanceUpdate', 'followUpNotes',
        'assignedEmployeeUid', 'assignedEmployeeName', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'studentId', 'studentName', 'centreId', 'attendanceStatus', 'participationLevel',
        'attendancePercentage', 'lastAttendanceUpdate', 'followUpNotes',
        'assignedEmployeeUid', 'assignedEmployeeName', 'employeeLocked', 'lockedByUid', 'lockedByName',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidId(data.centreId)
      && data.attendanceStatus in ['Regular', 'Irregular', 'Not Attending']
      && data.participationLevel in ['High', 'Moderate', 'Low', 'Inactive']
      && data.attendancePercentage is number && data.attendancePercentage >= 0 && data.attendancePercentage <= 100
      && isValidStr(data.lastAttendanceUpdate, 0, 30)
      && isValidStr(data.followUpNotes, 0, 1000)
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidAdmissionRecord(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'centreId', 'admissionStatus', 'stream',
        'niosPurpose', 'academicBackground', 'followUpStatus', 'assignedEmployeeUid',
        'assignedEmployeeName', 'remarks', 'admissionDate', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ]) && data.keys().hasOnly([
        'studentId', 'studentName', 'centreId', 'admissionStatus', 'stream',
        'niosPurpose', 'academicBackground', 'followUpStatus', 'assignedEmployeeUid',
        'assignedEmployeeName', 'remarks', 'admissionDate', 'employeeLocked', 'lockedByUid', 'lockedByName',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
      && isValidId(data.studentId)
      && isValidStr(data.studentName, 2, 120)
      && isValidId(data.centreId)
      && data.admissionStatus in ['Confirmed', 'Provisional', 'Pending Verification', 'Cancelled']
      && isValidStr(data.stream, 1, 80)
      && isValidStr(data.niosPurpose, 0, 1000)
      && isValidStr(data.academicBackground, 0, 1000)
      && data.followUpStatus in ['Completed', 'Pending Follow-up', 'Document Due']
      && isValidStr(data.assignedEmployeeUid, 0, 128)
      && isValidStr(data.assignedEmployeeName, 0, 100)
      && isValidStr(data.remarks, 0, 1000)
      && isValidStr(data.admissionDate, 4, 30)
      && (!('employeeLocked' in data) || data.employeeLocked is bool)
      && (!('lockedByUid' in data) || isValidStr(data.lockedByUid, 0, 128))
      && (!('lockedByName' in data) || isValidStr(data.lockedByName, 0, 100))
      && isValidStr(data.createdBy, 1, 128)
      && data.createdAt is timestamp
      && isValidStr(data.updatedBy, 1, 128)
      && data.updatedAt is timestamp;
    }

    function isValidEmployeeAssignment(data) {
      return data.keys().hasAll(['uid', 'employeeName', 'centreId', 'department', 'assignedBy', 'status', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['uid', 'employeeName', 'centreId', 'department', 'assignedBy', 'status', 'createdAt', 'updatedAt'])
      && isValidId(data.uid)
      && isValidStr(data.employeeName, 2, 100)
      && isValidId(data.centreId)
      && data.department in ['fee_recovery', 'practical', 'tma', 'online_classes', 'admission']
      && isValidStr(data.assignedBy, 1, 128)
      && data.status in ['Active', 'Inactive']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCentreAssignment(data) {
      return data.keys().hasAll(['centreId', 'centreName', 'headUid', 'headName', 'headEmail', 'assignedBy', 'createdAt', 'updatedAt'])
      && data.keys().hasOnly(['centreId', 'centreName', 'headUid', 'headName', 'headEmail', 'assignedBy', 'createdAt', 'updatedAt'])
      && isValidId(data.centreId)
      && isValidStr(data.centreName, 2, 120)
      && isValidId(data.headUid)
      && isValidStr(data.headName, 2, 100)
      && isValidStr(data.headEmail, 5, 160)
      && isValidStr(data.assignedBy, 1, 128)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll([
        'actorUid', 'actorName', 'actorEmail', 'actorRole', 'centreId',
        'department', 'action', 'targetCollection', 'targetId', 'details', 'locationVerified', 'createdAt'
      ]) && data.keys().hasOnly([
        'actorUid', 'actorName', 'actorEmail', 'actorRole', 'centreId',
        'department', 'action', 'targetCollection', 'targetId', 'details', 'locationVerified', 'createdAt'
      ])
      && isValidId(data.actorUid)
      && isValidStr(data.actorName, 1, 100)
      && isValidStr(data.actorEmail, 3, 160)
      && data.actorRole in ['super_admin', 'centre_head', 'employee']
      && isValidStr(data.centreId, 1, 64)
      && isValidStr(data.department, 1, 40)
      && isValidStr(data.action, 2, 100)
      && isValidStr(data.targetCollection, 1, 64)
      && isValidStr(data.targetId, 1, 128)
      && isValidStr(data.details, 0, 1000)
      && data.locationVerified is bool
      && data.createdAt is timestamp;
    }

    function isValidLocationVerification(data) {
      return data.keys().hasAll([
        'uid', 'userEmail', 'role', 'centreId', 'latitude', 'longitude',
        'accuracyMeters', 'distanceMeters', 'radiusMeters', 'verified', 'overrideApplied',
        'operation', 'nonce', 'createdAt'
      ]) && data.keys().hasOnly([
        'uid', 'userEmail', 'role', 'centreId', 'latitude', 'longitude',
        'accuracyMeters', 'distanceMeters', 'radiusMeters', 'verified', 'overrideApplied',
        'operation', 'nonce', 'createdAt'
      ])
      && isValidId(data.uid)
      && isValidStr(data.userEmail, 3, 160)
      && data.role in ['super_admin', 'centre_head', 'employee']
      && isValidId(data.centreId)
      && data.latitude is number
      && data.longitude is number
      && data.accuracyMeters is number
      && data.distanceMeters is number
      && data.radiusMeters is number
      && data.verified is bool
      && data.overrideApplied is bool
      && isValidStr(data.operation, 2, 120)
      && isValidStr(data.nonce, 4, 128)
      && data.createdAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
        'superAdminEmail', 'superAdminUid', 'geofenceEnabled',
        'emergencyOverrideActive', 'sessionTimeoutMinutes', 'maxGpsAccuracyMeters',
        'updatedAt', 'updatedBy'
      ]) && data.keys().hasOnly([
        'superAdminEmail', 'superAdminUid', 'geofenceEnabled',
        'emergencyOverrideActive', 'sessionTimeoutMinutes', 'maxGpsAccuracyMeters',
        'updatedAt', 'updatedBy'
      ])
      && isValidStr(data.superAdminEmail, 5, 160)
      && isValidId(data.superAdminUid)
      && data.geofenceEnabled is bool
      && data.emergencyOverrideActive is bool
      && data.sessionTimeoutMinutes is number && data.sessionTimeoutMinutes >= 5 && data.sessionTimeoutMinutes <= 1440
      && data.maxGpsAccuracyMeters is number && data.maxGpsAccuracyMeters >= 20 && data.maxGpsAccuracyMeters <= 5000
      && data.updatedAt is timestamp
      && isValidStr(data.updatedBy, 1, 128);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientUid', 'centreId', 'title', 'message', 'type', 'read', 'createdAt'])
      && data.keys().hasOnly(['recipientUid', 'centreId', 'title', 'message', 'type', 'read', 'createdAt'])
      && isValidStr(data.recipientUid, 1, 128)
      && isValidStr(data.centreId, 1, 64)
      && isValidStr(data.title, 1, 120)
      && isValidStr(data.message, 1, 500)
      && data.type in ['info', 'warning', 'security']
      && data.read is bool
      && data.createdAt is timestamp;
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll([
        'inviteId', 'fullName', 'email', 'mobileNumber', 'role', 'centreId', 'centreName',
        'department', 'joiningDate', 'status', 'claimedUid', 'invitedBy', 'invitedByName',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'inviteId', 'fullName', 'email', 'mobileNumber', 'role', 'centreId', 'centreName',
        'department', 'joiningDate', 'status', 'claimedUid', 'invitedBy', 'invitedByName',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.inviteId)
      && isValidStr(data.fullName, 2, 100)
      && isValidStr(data.email, 5, 160)
      && isValidStr(data.mobileNumber, 0, 20)
      && data.role in ['centre_head', 'employee']
      && isValidId(data.centreId)
      && isValidStr(data.centreName, 2, 120)
      && data.department in ['all', 'fee_recovery', 'practical', 'tma', 'online_classes', 'admission']
      && isValidStr(data.joiningDate, 4, 30)
      && data.status in ['Pending', 'Claimed']
      && isValidStr(data.claimedUid, 0, 128)
      && isValidStr(data.invitedBy, 1, 128)
      && isValidStr(data.invitedByName, 1, 100)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidEmployeeReport(data) {
      return data.keys().hasAll([
        'reportId', 'employeeUid', 'employeeName', 'employeeEmail', 'role', 'centreId', 'centreName',
        'department', 'reportDate', 'title', 'summary', 'tasksCompleted', 'studentsHandled',
        'pendingIssues', 'status', 'reviewerName', 'reviewerNote', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'reportId', 'employeeUid', 'employeeName', 'employeeEmail', 'role', 'centreId', 'centreName',
        'department', 'reportDate', 'title', 'summary', 'tasksCompleted', 'studentsHandled',
        'pendingIssues', 'status', 'reviewerName', 'reviewerNote', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.reportId)
      && isValidId(data.employeeUid)
      && isValidStr(data.employeeName, 2, 100)
      && isValidStr(data.employeeEmail, 5, 160)
      && data.role in ['super_admin', 'centre_head', 'employee']
      && isValidId(data.centreId)
      && isValidStr(data.centreName, 2, 120)
      && data.department in ['all', 'fee_recovery', 'practical', 'tma', 'online_classes', 'admission']
      && isValidStr(data.reportDate, 4, 30)
      && isValidStr(data.title, 3, 160)
      && isValidStr(data.summary, 5, 2000)
      && data.tasksCompleted is number && data.tasksCompleted >= 0 && data.tasksCompleted <= 10000
      && data.studentsHandled is number && data.studentsHandled >= 0 && data.studentsHandled <= 10000
