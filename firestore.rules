      && isValidStr(data.reviewerName, 0, 100)
      && isValidStr(data.reviewerNote, 0, 1000)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidEditRequest(data) {
      return data.keys().hasAll([
        'requestId', 'studentId', 'studentName', 'serialNumber', 'centreId', 'department',
        'requesterUid', 'requesterName', 'requesterEmail', 'reason', 'status',
        'reviewedByUid', 'reviewedByName', 'reviewerNote', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'requestId', 'studentId', 'studentName', 'serialNumber', 'centreId', 'department',
